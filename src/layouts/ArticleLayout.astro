---
import Navigation from '../components/Navigation';
import Footer from '../components/Footer';
import BaseHead from '../components/BaseHead.astro';
import Icon from '../components/Icon';
import ArticleNavigation from '../components/ArticleNavigation';
import TableOfContents from '../components/TableOfContents';
import { AUTHOR_NAME, JOB_TITLE, LINKEDIN_URL, GITHUB_HANDLE } from '../consts';
import { ARTICLE_GROUPS } from '../articleGroups';
import { personJsonLd, personRef, canonical, DEFAULT_OG_IMAGE, X_PROFILE_URL } from '../lib/schema';

const { title, subtitle, readingTime, tags, category, mediumUrl, githubUrl, prevArticle, nextArticle, groupName, groupTotal, headings = [], date, description, heroImage, group, wordCount, lastModified } = Astro.props;

// Create article URL
const articleUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Group hub metadata, used for both the breadcrumb trail and the JSON-LD.
const groupInfo = group ? ARTICLE_GROUPS[group] : undefined;

// Resolve image metadata: heroImage may be an ImageMetadata object with width/height
const imageUrl = heroImage ? new URL(heroImage.src ?? heroImage, Astro.site).toString() : undefined;
const imageWidth = heroImage?.width;
const imageHeight = heroImage?.height;

// Visible publish/update info for the byline
const publishedIso = date ? date.toISOString() : undefined;
const publishedLabel = date ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : undefined;
const modifiedDate = lastModified ? new Date(lastModified) : undefined;
const modifiedIso = modifiedDate ? modifiedDate.toISOString() : undefined;
const modifiedLabel = modifiedDate ? modifiedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : undefined;
// Show "Updated" only when the modification is meaningful (more than 7 days after publish)
const showUpdated = Boolean(modifiedDate && date && modifiedDate.getTime() - date.getTime() > 7 * 24 * 60 * 60 * 1000);

// Build JSON-LD structured data
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Article",
	"headline": title,
	"description": description || subtitle || title,
	"inLanguage": "en",
	// Full Person node so each article page is a self-contained E-E-A-T signal,
	// sharing one @id with the homepage and /about.
	"author": personJsonLd,
	"datePublished": date?.toISOString(),
	"dateModified": lastModified ?? date?.toISOString(),
	"publisher": personRef,
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": articleUrl
	},
	"keywords": tags?.join(', '),
	"articleSection": category,
	...(wordCount && { "wordCount": wordCount }),
	// Every article needs an image; fall back to the same default card OG uses.
	"image": imageUrl ?? DEFAULT_OG_IMAGE,
	...(githubUrl && { "codeRepository": githubUrl })
};

// Build breadcrumb structured data.
// Mirrors the visible trail: Home > Articles > <Group> > <Title>.
// Articles whose group has no hub page fall back to the 3-level trail.
const breadcrumbItems = [
	{
		"@type": "ListItem",
		"position": 1,
		"name": "Home",
		"item": canonical()
	},
	{
		"@type": "ListItem",
		"position": 2,
		"name": "Articles",
		"item": canonical('articles')
	},
	...(groupInfo ? [{
		"@type": "ListItem",
		"position": 3,
		"name": groupInfo.name,
		"item": canonical(`articles/${group}`)
	}] : []),
];

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		...breadcrumbItems,
		{
			"@type": "ListItem",
			"position": breadcrumbItems.length + 1,
			"name": title,
			"item": articleUrl
		}
	]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
	<head>
		<BaseHead
			title={title}
			description={description || subtitle || title}
			image={imageUrl}
			imageWidth={imageWidth}
			imageHeight={imageHeight}
			article={{
				publishedTime: date,
				modifiedTime: lastModified ? new Date(lastModified) : date,
				section: category,
				tags: tags,
			}}
		/>
		
		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
		
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
		<!-- Global, not scoped: these rules target MDX output and the wrapper the
		     mermaid script injects at runtime, neither of which carries a scope id. -->
		<style is:global>
			/* Mermaid diagram styling for img-based rendering.
			   Colours come from the theme tokens, so a single rule covers both themes. */
			.prose img[id^="mermaid-"],
			.prose picture {
				background-color: var(--c-surface);
				border-radius: 2px;
				padding: 1.5rem;
				margin: 2rem 0;
				width: 100%;
				height: auto;
				display: block;
				border: 1px solid var(--c-rule);
			}

			.prose picture img {
				margin: 0;
				padding: 0;
				background-color: transparent;
				border: none;
			}

			.prose .mermaid-wrapper {
				position: relative;
				background-color: var(--c-surface);
				border-radius: 2px;
				padding: 1.5rem;
				margin: 2rem 0;
				border: 1px solid var(--c-rule);
			}

			.prose .mermaid-wrapper img[id^="mermaid-"],
			.prose .mermaid-wrapper picture {
				background-color: transparent;
				padding: 0;
				margin: 0;
				border: none;
			}

			/* Mermaid expand button: appears on hover or keyboard focus. */
			.mermaid-expand-btn {
				position: absolute;
				top: 0.75rem;
				right: 0.75rem;
				padding: 0.5rem;
				background-color: var(--c-paper);
				border: 1px solid var(--c-rule);
				border-radius: 2px;
				color: var(--c-ink-3);
				cursor: pointer;
				opacity: 0;
				transition: opacity 150ms var(--ease-out-quint),
					color 150ms var(--ease-out-quint),
					border-color 150ms var(--ease-out-quint);
				z-index: 10;
			}

			.mermaid-wrapper:hover .mermaid-expand-btn,
			.mermaid-expand-btn:focus-visible {
				opacity: 1;
			}

			.mermaid-expand-btn:hover {
				color: var(--c-ink);
				border-color: var(--c-rule-strong);
			}

			/* Dialog styling */
			#mermaid-dialog {
				background-color: var(--c-paper);
				color: var(--c-ink);
				border: none;
				max-width: 100vw;
				max-height: 100vh;
				width: 100vw;
				height: 100vh;
				padding: 0;
				margin: 0;
			}

			#mermaid-dialog::backdrop {
				background-color: var(--c-paper);
			}

			.dialog-controls {
				position: fixed;
				top: 1rem;
				right: 1rem;
				display: flex;
				gap: 0.5rem;
				z-index: 100;
			}

			.dialog-zoom-level {
				position: fixed;
				top: 1rem;
				left: 1rem;
				padding: 0.5rem 0.75rem;
				background-color: var(--c-surface);
				color: var(--c-ink-3);
				border-radius: 2px;
				border: 1px solid var(--c-rule);
				font-size: var(--text-sm);
				font-family: var(--font-mono);
				font-variant-numeric: tabular-nums;
				z-index: 100;
			}

			.dialog-content-wrapper {
				width: 100%;
				height: 100%;
				overflow: auto;
				padding: 0;
				display: grid;
				place-items: center;
			}

			.dialog-content {
				transition: transform 0.2s ease;
				transform-origin: center center;
				width: 100%;
				height: 100%;
				padding: 6rem 2rem 2rem 2rem;
				display: grid;
				place-items: center;
			}

			.dialog-content svg {
				max-width: 100%;
				max-height: 100%;
				width: auto;
				height: auto;
				object-fit: contain;
			}

			/* Math formula styling */
			.prose .katex {
				font-size: 1.1em;
			}

			.prose .katex-display {
				margin: 2rem 0;
				overflow-x: auto;
				overflow-y: hidden;
			}

			.prose .katex-display > .katex {
				text-align: center;
			}
		</style>
	</head>
	<body class="bg-paper text-ink-2 font-sans overflow-x-hidden">
		<Navigation client:load />

        <main id="main" class="max-w-measure mx-auto px-6 pt-28 pb-24" data-pagefind-body>
             <article id="article-content" class="prose max-w-none">
                <div class="mb-12 not-prose">
                    {groupInfo && (
                        <a 
                            href={`/articles/${group}/`}
                            class="inline-flex items-center gap-2 text-sm text-ink-3 hover:text-ink mb-6 transition-colors"
                        >
                            <Icon name="arrow-left" className="w-4 h-4" size={16} />
                            <span>{groupInfo.name}</span>
                        </a>
                    )}

                    <h1 class="text-3xl md:text-4xl mb-4 text-ink">{title}</h1>
                    {subtitle && <p class="text-lg text-ink-2">{subtitle}</p>}

                    {/* One quiet byline: author and date pair up, the rest is separated by space only. */}
                    <div class="flex flex-wrap items-center gap-x-5 gap-y-1 mt-6 text-sm text-ink-3">
                        {date && (
                            <span>
                                By <a href="/about/" rel="author" class="hover:text-ink transition-colors">{AUTHOR_NAME}</a>
                                <span aria-hidden="true"> · </span>
                                <time datetime={publishedIso}>{publishedLabel}</time>
                            </span>
                        )}
                        {readingTime && <span>{readingTime}</span>}
                        {showUpdated && (
                            <span>Updated <time datetime={modifiedIso}>{modifiedLabel}</time></span>
                        )}
                    </div>

                    {tags && (
                         <div class="flex flex-wrap gap-x-4 gap-y-1 mt-3 text-xs text-ink-3">
                            {tags.map((tag: string) => (
                                <span>{tag}</span>
                            ))}
                         </div>
                    )}
                </div>
                <slot />
                
                {(mediumUrl || githubUrl) && (
                    <div class="not-prose mt-12 pt-8 border-t border-rule flex flex-wrap gap-x-6 gap-y-3 text-sm">
                        {githubUrl && (
                            <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-ink-2 hover:text-ink transition-colors">
                                <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                </svg>
                                <span>View on GitHub</span>
                            </a>
                        )}
                        {mediumUrl && (
                            <a href={mediumUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-ink-2 hover:text-ink transition-colors">
                                <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
                                </svg>
                                <span>Read on Medium</span>
                            </a>
                        )}
                    </div>
                )}
             </article>

             {/* Author bio: turns an anonymous post into an attributed one. */}
             <aside class="mt-16 pt-6 border-t border-rule">
                <a href="/about/" rel="author" class="text-lg font-semibold text-ink hover:underline underline-offset-4 decoration-rule-strong">
                    {AUTHOR_NAME}
                </a>
                <p class="text-sm text-ink-3 mt-1 mb-3">{JOB_TITLE}</p>
                <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                    <a href="/about/" class="link-quiet">About</a>
                    <a href={`https://github.com/${GITHUB_HANDLE}`} target="_blank" rel="noopener noreferrer me" class="link-quiet">GitHub</a>
                    <a href={X_PROFILE_URL} target="_blank" rel="noopener noreferrer me" class="link-quiet">X</a>
                    <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer me" class="link-quiet">LinkedIn</a>
                </div>
             </aside>
             
             <ArticleNavigation 
                client:load
                prevArticle={prevArticle}
                nextArticle={nextArticle}
                groupName={groupName}
                groupTotal={groupTotal}
             />
        </main>

        <Footer />

		<!-- Table of Contents -->
		<TableOfContents client:load headings={headings} />

		<!-- Mermaid Dialog Modal -->
		<dialog id="mermaid-dialog" aria-label="Diagram viewer">
			<div class="dialog-controls">
				<button id="zoom-out-btn" class="p-3 bg-surface hover:bg-paper text-ink rounded-sm border border-rule hover:border-rule-strong transition-colors" title="Zoom out" aria-label="Zoom out">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="11" cy="11" r="8"/>
						<path d="m21 21-4.3-4.3"/>
						<path d="M8 11h6"/>
					</svg>
				</button>
				<button id="zoom-in-btn" class="p-3 bg-surface hover:bg-paper text-ink rounded-sm border border-rule hover:border-rule-strong transition-colors" title="Zoom in" aria-label="Zoom in">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="11" cy="11" r="8"/>
						<path d="m21 21-4.3-4.3"/>
						<path d="M11 8v6"/>
						<path d="M8 11h6"/>
					</svg>
				</button>
				<button id="close-dialog-btn" class="p-3 bg-surface hover:bg-paper text-ink rounded-sm border border-rule hover:border-rule-strong transition-colors" title="Close" aria-label="Close diagram viewer">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M18 6 6 18"/>
						<path d="m6 6 12 12"/>
					</svg>
				</button>
			</div>
			<div class="dialog-zoom-level" id="zoom-level">100%</div>
			<div class="dialog-content-wrapper">
				<div class="dialog-content" id="dialog-content"></div>
			</div>
		</dialog>

		<script is:inline data-astro-rerun>
			// ClientRouter enables soft navigation, so DOMContentLoaded only fires once
			// per hard load. Everything here must re-run on every article swap, which is
			// why setup lives on astro:page-load and this tag carries data-astro-rerun
			// (Astro otherwise de-dupes identical inline scripts across swaps). The whole
			// body is wrapped in an IIFE so re-running the tag does not redeclare the
			// top-level let/const bindings in the shared page scope.
			(() => {
			function setup() {
			let currentScale = 1;
			const dialog = document.getElementById('mermaid-dialog');
			const dialogContent = document.getElementById('dialog-content');
			const zoomLevel = document.getElementById('zoom-level');

			// Handle mermaid theme switching
			function updateMermaidTheme() {
				const isDark = document.documentElement.classList.contains('dark');
				const pictures = document.querySelectorAll('picture');
				
				pictures.forEach((picture) => {
					// Look for source with id starting with "mermaid-" (dark version)
					const darkSource = picture.querySelector('source[id^="mermaid-"]');
					const img = picture.querySelector('img');
					
					if (darkSource && img) {
						// Get both versions directly from DOM on first run
						if (!img.hasAttribute('data-light-src')) {
							const lightSrc = img.getAttribute('src');
							const darkSrc = darkSource.getAttribute('srcset');
							
							// Store original sources
							img.setAttribute('data-light-src', lightSrc);
							if (darkSrc) {
								img.setAttribute('data-dark-src', darkSrc);
							}
							
							// Disable the native picture element's media query behavior
							// by removing the media attribute - we'll handle switching manually
							darkSource.removeAttribute('media');
							darkSource.removeAttribute('srcset');
						}

						// Switch based on theme
						const storedDarkSrc = img.getAttribute('data-dark-src');
						const storedLightSrc = img.getAttribute('data-light-src');
						
						if (isDark && storedDarkSrc) {
							if (img.src !== storedDarkSrc) {
								img.src = storedDarkSrc;
							}
						} else if (!isDark && storedLightSrc) {
							if (img.src !== storedLightSrc) {
								img.src = storedLightSrc;
							}
						}
					}
				});
			}

			function setupMermaidButtons() {
				// Find all picture elements that contain mermaid diagrams
				const mermaidPictures = document.querySelectorAll('picture');
				
				if (mermaidPictures.length === 0) return;

				mermaidPictures.forEach((picture) => {
					// Check if this picture contains a mermaid diagram
					const darkSource = picture.querySelector('source[id^="mermaid-"]');
					if (!darkSource) return;

					// Skip if already wrapped
					if (picture.parentElement?.classList.contains('mermaid-wrapper')) return;

					// Create wrapper
					const wrapper = document.createElement('div');
					wrapper.className = 'mermaid-wrapper';
					picture.parentElement?.insertBefore(wrapper, picture);
					wrapper.appendChild(picture);

					// Create expand button
					const expandBtn = document.createElement('button');
					expandBtn.innerHTML = `
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
						</svg>
					`;
					expandBtn.className = 'mermaid-expand-btn';
					expandBtn.title = 'Expand diagram';
					expandBtn.onclick = () => {
						const img = picture.querySelector('img');
						if (!img) return;

						const src = img.src;
						if (src.startsWith('data:image/svg+xml') && dialogContent && dialog) {
							const svgData = decodeURIComponent(src.split(',')[1]);
							dialogContent.innerHTML = svgData;
							currentScale = 1;
							updateZoom();
							dialog.showModal();
						}
					};

					wrapper.appendChild(expandBtn);
				});
			}

			function updateZoom() {
				if (dialogContent) {
					dialogContent.style.transform = `scale(${currentScale})`;
				}
				if (zoomLevel) {
					zoomLevel.textContent = `${Math.round(currentScale * 100)}%`;
				}
			}

			// Run setup: called fresh on every astro:page-load, which fires on first
			// load and every soft navigation alike.
			updateMermaidTheme();
			setupMermaidButtons();

			const zoomInBtn = document.getElementById('zoom-in-btn');
			const zoomOutBtn = document.getElementById('zoom-out-btn');
			const closeBtn = document.getElementById('close-dialog-btn');

			zoomInBtn?.addEventListener('click', () => {
				currentScale = Math.min(currentScale + 0.2, 3);
				updateZoom();
			});

			zoomOutBtn?.addEventListener('click', () => {
				currentScale = Math.max(currentScale - 0.2, 0.5);
				updateZoom();
			});

			closeBtn?.addEventListener('click', () => {
				dialog?.close();
			});

			// Dialog also closes with ESC key (built-in feature)

			// Listen for theme changes fired by the theme toggle.
			window.addEventListener('theme-changed', updateMermaidTheme);
			}

			document.addEventListener('astro:page-load', setup);
			})();
		</script>
    </body>
</html>
