---
import BaseHead from '../components/BaseHead.astro';
import Navigation from '../components/Navigation';
import Footer from '../components/Footer';
import Icon from '../components/Icon';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import { personJsonLd, canonical } from '../lib/schema';

const projects = (await getCollection('projects'))
	.filter((project) => !project.data.draft)
	.sort((a, b) => a.data.order - b.data.order);

const pageTitle = `Projects | ${SITE_TITLE}`;
const pageDescription = 'Seven systems across Web3 infrastructure, self-hosted AI sandboxes and embedded firmware, each with the metrics that came out of running it.';

const projectsJsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": pageTitle,
	"description": pageDescription,
	"url": canonical('projects'),
	"mainEntity": {
		"@type": "ItemList",
		"numberOfItems": projects.length,
		"itemListElement": projects.map((project, i) => ({
			"@type": "ListItem",
			"position": i + 1,
			"url": canonical(`projects/${project.id}`),
			"name": project.data.name,
		})),
	},
	"author": personJsonLd,
};

const statusLabel: Record<string, string> = {
	production: 'In Production',
	internal: 'Internal Tool',
	personal: 'Personal Project',
	archived: 'Archived',
};

/**
 * A metric only earns a row on this page when it carries a measured number. The
 * qualitative entries in the frontmatter stay off the index and are rendered on
 * the project page instead, so the accent keeps meaning "this was measured".
 *
 * Seven projects worth of accented numbers would flood the screen, so only the
 * lead record spends the accent. The rest carry the same measurements in mono
 * ink, which is also what makes the lead the focal point of the page.
 */
const isMeasured = (value: string) => /\d/.test(value);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script type="application/ld+json" set:html={JSON.stringify(projectsJsonLd)} />
	</head>
	<body class="bg-paper" data-pagefind-ignore>
		<div class="min-h-screen bg-paper font-sans text-ink-2">
			<Navigation client:load />

			<main id="main" class="mx-auto max-w-page px-6 pt-28 pb-24">
				<header class="mb-16">
					<h1 class="mb-5 text-3xl font-semibold text-ink md:text-4xl">Projects</h1>
					<p class="max-w-measure text-md text-ink-2">
						Seven systems, each shipped end to end: the problem, the substrate, and the
						measurements it produced.
					</p>
				</header>

				{/* Records, separated by a single hairline. No card, no box. */}
				<section class="border-t border-rule">
					{projects.map((project, index) => {
						const lead = index === 0;
						const metrics = project.data.metrics
							.filter((metric) => isMeasured(metric.value))
							.slice(0, lead ? 4 : 3);

						return (
							<a
								href={`/projects/${project.id}/`}
								class={`group -mx-4 block border-b border-rule px-4 transition-colors duration-150 ${
									lead ? 'py-10' : 'py-8'
								}`}
							>
								{/* Two columns from md up, a single stacked column below it. */}
								<div class="grid gap-x-10 gap-y-5 md:grid-cols-12">
									<div class="md:col-span-4">
										<div class="flex items-start gap-3">
											<Icon
												name={project.data.icon}
												className={`${lead ? 'h-6 w-6' : 'h-5 w-5'} shrink-0 text-ink-3 [stroke-width:1.5]`}
											/>
											<div class="min-w-0">
												<h2
													class={`font-semibold text-ink underline decoration-transparent underline-offset-4 transition-colors duration-150 group-hover:decoration-rule-strong ${
														lead ? 'text-2xl' : 'text-xl'
													}`}
												>
													{project.data.name}
												</h2>
												<p class="mt-2 text-xs text-ink-3">{project.data.role}</p>
												<p class="font-mono text-xs text-ink-3">{project.data.period}</p>
												<p class="mt-2 text-xs text-ink-3">
													{statusLabel[project.data.status]}
												</p>
											</div>
										</div>
									</div>

									<div class="md:col-span-8">
										<p class={`text-ink ${lead ? 'text-md' : 'text-base'}`}>
											{project.data.tagline}
										</p>
										<p class="mt-2 max-w-measure text-sm text-ink-2">
											{project.data.description}
										</p>

										{metrics.length > 0 && (
											<dl class="mt-6 flex flex-wrap gap-x-10 gap-y-4">
												{/* Each pair is reversed so the value reads first while dt stays before dd. */}
												{metrics.map((metric) => (
													<div class="flex flex-col-reverse">
														<dt class="mt-1 text-xs text-ink-3">{metric.label}</dt>
														<dd
															class={lead ? 'metric-value text-2xl' : 'font-mono text-xl text-ink'}
														>
															{metric.value}
														</dd>
													</div>
												))}
											</dl>
										)}

										<ul class="mt-6 flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs text-ink-3">
											{project.data.tech.slice(0, 8).map((tech) => (
												<li>{tech}</li>
											))}
										</ul>
									</div>
								</div>
							</a>
						);
					})}
				</section>
			</main>

			<Footer />
		</div>
	</body>
</html>
