---
import BaseHead from '../../components/BaseHead.astro';
import Navigation from '../../components/Navigation';
import Footer from '../../components/Footer';
import { ArticleRow } from '../../components/ArticleGroups';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../consts';
import { ARTICLE_GROUPS } from '../../articleGroups';
import { personJsonLd, canonical } from '../../lib/schema';
import { getReadingTime } from '../../lib/readingTime';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
	const articles = (await getCollection('articles')).filter((article) => !article.data.draft);
	
	// Get all unique categories from article groups
	const categories = Object.keys(ARTICLE_GROUPS);
	
	return categories.map((category) => ({
		params: { category },
		props: {
			articles: articles.filter((article) => article.data.group === category),
			groupInfo: ARTICLE_GROUPS[category],
		},
	}));
}) satisfies GetStaticPaths;

const { articles, groupInfo } = Astro.props;

// Sort articles by date (newest first)
const sortedArticles = articles.sort((a: any, b: any) => 
	b.data.date.getTime() - a.data.date.getTime()
);

// The hub reuses the archive row, so both surfaces stay in one shape.
const rows = sortedArticles.map((article: any) => ({
	id: article.id,
	title: article.data.title,
	subtitle: article.data.subtitle,
	category: article.data.category,
	tags: article.data.tags,
	readTime: getReadingTime(article.body || ''),
	date: article.data.date,
	icon: article.data.icon,
	iconColor: article.data.iconColor,
	description: article.data.description,
	slug: article.id,
	githubUrl: article.data.githubUrl,
	group: article.data.group,
}));

const pageTitle = `${groupInfo.name} Articles | ${SITE_TITLE}`;
const pageDescription = groupInfo.description;
const categoryUrl = canonical(`articles/${Astro.params.category}`);

// CollectionPage JSON-LD
const collectionJsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": pageTitle,
	"description": pageDescription,
	"url": categoryUrl,
	"mainEntity": {
		"@type": "ItemList",
		"numberOfItems": sortedArticles.length,
		"itemListElement": sortedArticles.map((article: any, i: number) => ({
			"@type": "ListItem",
			"position": i + 1,
			"url": canonical(`articles/${article.id}`),
			"name": article.data.title,
		})),
	},
	"author": personJsonLd,
};

// BreadcrumbList JSON-LD
const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": canonical()
		},
		{
			"@type": "ListItem",
			"position": 2,
			"name": "Articles",
			"item": canonical('articles')
		},
		{
			"@type": "ListItem",
			"position": 3,
			"name": groupInfo.name,
			"item": categoryUrl
		}
	]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
	</head>
	<body class="bg-paper">
		<div class="min-h-screen bg-paper font-sans">
			<Navigation client:load />

			<main id="main" class="max-w-page mx-auto px-6 pt-28 pb-20">
				<header class="border-b border-rule pb-8">
					<a href="/articles/" class="link-quiet text-sm">All articles</a>

					<h1 class="mt-5 text-3xl text-ink md:text-4xl">{groupInfo.name}</h1>

					<p class="mt-3 max-w-measure text-ink-2">
						{groupInfo.description}
					</p>

					<p class="mt-4 text-sm text-ink-3">
						<span class="metric-value">{sortedArticles.length}</span>{' '}{sortedArticles.length === 1 ? 'article' : 'articles'}
					</p>
				</header>

				{rows.length > 0 ? (
					<ul class="mt-8">
						{rows.map((article) => (
							<ArticleRow article={article} titleAs="h2" />
						))}
					</ul>
				) : (
					<div class="mt-8 border-t border-rule py-16">
						<p class="max-w-measure text-ink-2">
							Nothing is published in this group yet. The rest of the archive is on the
							all articles page.
						</p>
						<a href="/articles/" class="btn btn-secondary mt-5">Show all articles</a>
					</div>
				)}
			</main>

			<Footer />
		</div>
	</body>
</html>
