---
import BaseHead from '../components/BaseHead.astro';
import Navigation from '../components/Navigation';
import Footer from '../components/Footer';
import Icon from '../components/Icon';
import { getCollection } from 'astro:content';
import {
	AUTHOR_NAME,
	JOB_TITLE,
	TAGLINE,
	AVAILABILITY,
	CALENDLY_URL,
	CONTACT_LABEL,
	TELEGRAM_URL,
	TELEGRAM_HANDLE,
	GITHUB_HANDLE,
	LINKEDIN_URL,
} from '../consts';
import { CAREER } from '../data/career';
import { CONTRIBUTIONS } from '../data/contributions';
import { GAS_GOLFING } from '../data/highlights';
import { personJsonLd, personRef, canonical, X_PROFILE_URL } from '../lib/schema';

const articles = (await getCollection('articles')).filter((article) => !article.data.draft);
const projects = (await getCollection('projects'))
	.filter((project) => !project.data.draft)
	.sort((a, b) => a.data.order - b.data.order);

const articleCount = articles.length;

// Kept inside SERP limits: title <= 60 chars, description 150-160.
const pageTitle = `About ${AUTHOR_NAME} | Web3 Infrastructure`;
const pageDescription = `${AUTHOR_NAME}, CTO at Frak Labs: account abstraction, WebAuthn wallets and self-hosted infrastructure, across ${articleCount} engineering deep-dives.`;
const aboutUrl = canonical('about');

const profileJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	'@id': `${aboutUrl}#profilepage`,
	url: aboutUrl,
	name: pageTitle,
	description: pageDescription,
	inLanguage: 'en',
	mainEntity: personJsonLd,
	about: personRef,
};

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: canonical() },
		{ '@type': 'ListItem', position: 2, name: 'About', item: aboutUrl },
	],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script type="application/ld+json" set:html={JSON.stringify(profileJsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
	</head>
	<body class="bg-paper">
		<div class="min-h-screen bg-paper font-sans text-ink-2">
			<Navigation client:load />

			<main id="main" class="mx-auto max-w-page px-6 pt-28 pb-24">
				<section class="mb-20">
					<h1 class="text-3xl font-semibold text-ink md:text-4xl">About {AUTHOR_NAME}</h1>
					<p class="mt-3 text-lg text-ink-2">{JOB_TITLE}</p>

					{/* Long copy stays on the reading column, under 80 characters a line. */}
					<div class="mt-8 max-w-measure space-y-4 text-md">
						<p>{TAGLINE}</p>
						<p>
							The substrates change, the job does not: smart contracts and account
							abstraction wallets, self-hosted Kubernetes, bare-metal Rust firmware,
							Android apps, and the tooling that keeps them shippable. Everything here is
							written from a system that runs, not from a tutorial.
						</p>
					</div>

					{/* Two measured facts, each linked to its source. */}
					<dl class="mt-10 flex flex-wrap gap-x-12 gap-y-6">
						{/* Reversed so the value reads first while dt stays before dd. */}
						<div class="flex flex-col-reverse">
							<dt class="mt-1 text-xs text-ink-3">articles written from production systems</dt>
							<dd>
								<a
									href="/articles/"
									class="metric-value text-2xl underline decoration-transparent underline-offset-4 transition-colors duration-150 hover:decoration-signal"
								>
									{articleCount}
								</a>
							</dd>
						</div>
						<div class="flex flex-col-reverse">
							<dt class="mt-1 text-xs text-ink-3">{GAS_GOLFING.label}</dt>
							<dd>
								<a
									href={GAS_GOLFING.href}
									target="_blank"
									rel="noopener noreferrer"
									class="metric-value text-2xl underline decoration-transparent underline-offset-4 transition-colors duration-150 hover:decoration-signal"
								>
									{GAS_GOLFING.value}
								</a>
							</dd>
						</div>
					</dl>

					<ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm">
						<li>
							<a
								href={`https://github.com/${GITHUB_HANDLE}`}
								target="_blank"
								rel="noopener noreferrer me"
								class="link">GitHub</a
							>
						</li>
						<li>
							<a href={X_PROFILE_URL} target="_blank" rel="noopener noreferrer me" class="link"
								>X</a
							>
						</li>
						<li>
							<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer me" class="link"
								>LinkedIn</a
							>
						</li>
					</ul>
				</section>

				<section class="mb-20">
					<h2 class="text-xl font-semibold text-ink">Career</h2>

					{/* Period column at md and up, stacked above the role below it. */}
					<div class="mt-6 border-t border-rule">
						{CAREER.map((entry) => (
							<div class="grid gap-x-10 gap-y-1 border-b border-rule py-6 md:grid-cols-12">
								<p class="font-mono text-xs text-ink-3 md:col-span-3">{entry.period}</p>
								<div class="md:col-span-9">
									<h3 class="text-base font-medium text-ink">
										{entry.role}
										<span class="mx-2 text-ink-3" aria-hidden="true">·</span>
										{entry.url ? (
											<a href={entry.url} target="_blank" rel="noopener noreferrer" class="link">
												{entry.org}
											</a>
										) : (
											<span>{entry.org}</span>
										)}
									</h3>
									<p class="mt-1 max-w-measure text-sm text-ink-2">{entry.detail}</p>
								</div>
							</div>
						))}
					</div>
				</section>

				<section class="mb-20">
					<div class="flex items-baseline justify-between gap-6">
						<h2 class="text-xl font-semibold text-ink">Projects</h2>
						<a href="/projects/" class="link-quiet text-sm">View all</a>
					</div>

					<div class="mt-6 border-t border-rule">
						{projects.map((project) => (
							<a
								href={`/projects/${project.id}/`}
								class="group -mx-4 grid gap-x-10 gap-y-1 border-b border-rule px-4 py-5 transition-colors duration-150 md:grid-cols-12"
							>
								<div class="flex items-center gap-3 md:col-span-4">
									<Icon
										name={project.data.icon}
										className="h-5 w-5 shrink-0 text-ink-3 [stroke-width:1.5]"
									/>
									<h3 class="text-base font-medium text-ink underline decoration-transparent underline-offset-4 transition-colors duration-150 group-hover:decoration-rule-strong">
										{project.data.name}
									</h3>
								</div>
								<p class="text-xs text-ink-3 md:col-span-2">{project.data.role}</p>
								<p class="max-w-measure text-sm text-ink-2 md:col-span-6">
									{project.data.tagline}
								</p>
							</a>
						))}
					</div>
				</section>

				<section class="mb-20">
					<h2 class="text-xl font-semibold text-ink">Open source</h2>
					<p class="mt-3 max-w-measure text-sm text-ink-2">
						Upstream work on the tools other people ship on.
					</p>

					{/* Project column at md and up, stacked above the patches below it. */}
					<div class="mt-6 border-t border-rule">
						{CONTRIBUTIONS.map((contribution) => (
							<div class="grid gap-x-10 gap-y-2 border-b border-rule py-5 md:grid-cols-12">
								<div class="md:col-span-4">
									<a
										href={contribution.url}
										target="_blank"
										rel="noopener noreferrer"
										class="link text-base font-medium"
									>
										{contribution.project}
									</a>
									<p class="mt-1 text-xs text-ink-3">{contribution.context}</p>
								</div>
								<ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm md:col-span-8">
									{contribution.items.map((item) => (
										<li>
											<a href={item.url} target="_blank" rel="noopener noreferrer" class="link">
												{item.label}
											</a>
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
				</section>

				<section class="border-t border-rule pt-12">
					<h2 class="text-xl font-semibold text-ink">Contact</h2>
					<p class="mt-3 max-w-measure text-ink-2">
						Taking on new work from {AVAILABILITY}. Smart wallets, self-hosted
						infrastructure, embedded work, or anything you read here.
					</p>

					{/* Stacked buttons below sm, side by side above it. */}
					<div class="mt-6 flex flex-col gap-3 sm:flex-row">
						<a
							href={CALENDLY_URL}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-primary"
						>
							<Icon name="calendar" className="h-4 w-4 [stroke-width:1.5]" />
							{CONTACT_LABEL}
						</a>
						<a
							href={TELEGRAM_URL}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-secondary"
						>
							<Icon name="message-circle" className="h-4 w-4 [stroke-width:1.5]" />
							{TELEGRAM_HANDLE}
						</a>
					</div>
				</section>
			</main>

			<Footer />
		</div>
	</body>
</html>
