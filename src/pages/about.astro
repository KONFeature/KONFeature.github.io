---
import BaseHead from '../components/BaseHead.astro';
import Navigation from '../components/Navigation';
import Footer from '../components/Footer';
import Icon from '../components/Icon';
import { getCollection } from 'astro:content';
import {
	AUTHOR_NAME,
	JOB_TITLE,
	TAGLINE,
	AVAILABILITY,
	CALENDLY_URL,
	TELEGRAM_URL,
	TELEGRAM_HANDLE,
	GITHUB_HANDLE,
	LINKEDIN_URL,
	links,
} from '../consts';
import { personJsonLd, personRef, canonical, X_PROFILE_URL } from '../lib/schema';

const articles = (await getCollection('articles')).filter((article) => !article.data.draft);
const projects = (await getCollection('projects'))
	.filter((project) => !project.data.draft)
	.sort((a, b) => a.data.order - b.data.order);

const articleCount = articles.length;

// Kept inside SERP limits: title <= 60 chars, description 150-160.
const pageTitle = `About ${AUTHOR_NAME} | Web3 Infrastructure`;
const pageDescription = `${AUTHOR_NAME}, CTO at Frak Labs: account abstraction, WebAuthn wallets and self-hosted infrastructure, across ${articleCount} engineering deep-dives.`;
const aboutUrl = canonical('about');

// Career history, sourced from src/components/Timeline.tsx.
const career = [
	{
		period: '2022 - present',
		role: 'Co-Founder & CTO',
		org: 'Frak Labs',
		url: links.frak,
		detail:
			'Building content monetization infrastructure: a self-custodial WebAuthn smart wallet embedded into Shopify and WordPress stores, and the on-chain reward system behind it.',
	},
	{
		period: '2021 - 2023',
		role: 'Lead Android Engineer',
		org: 'Sybel',
		detail:
			'Android and Android Automotive apps, including a partnership with Renault for their onboard system launch.',
	},
	{
		period: '2019 - 2020',
		role: 'Freelance Android Developer',
		org: 'Various clients',
		detail: 'Custom mobile experiences, including the Coyali app to help seniors use smartphones.',
	},
	{
		period: '2017 - 2020',
		role: 'Mobile Engineer Consultant',
		org: 'Capgemini / SNCF',
		detail:
			'Android applications for onboard agents and ticket validation terminals on the French railway system.',
	},
	{
		period: '2016 - 2017',
		role: 'Full Stack Freelancer',
		org: 'Construction sector (BTP)',
		detail: 'PHP automation tools for inventory management and vehicle mileage tracking.',
	},
];

// Open-source contributions, sourced from src/components/LandingPage.tsx.
const contributions = [
	{
		project: 'ZeroDev Kernel',
		context: 'Account Abstraction',
		url: links.kernel,
		items: [
			{ label: 'WebAuthn validator', url: 'https://github.com/zerodevapp/kernel/pull/68' },
			{ label: 'EIP-712 typed data', url: 'https://github.com/zerodevapp/kernel/pull/55' },
			{ label: 'Gas optimizations', url: 'https://github.com/zerodevapp/kernel/pull/50' },
		],
	},
	{
		project: 'eRPC',
		context: 'RPC Load Balancer',
		url: links.erpc,
		items: [
			{ label: 'JS/TS config', url: 'https://github.com/erpc/erpc/pull/123' },
			{ label: 'CLI tooling', url: 'https://github.com/erpc/erpc/pull/143' },
			{ label: 'Config validation', url: 'https://github.com/erpc/erpc/pull/139' },
		],
	},
	{
		project: 'Permissionless.js',
		context: 'Pimlico SDK',
		url: links.permissionless,
		items: [
			{ label: 'Kernel wallet support', url: 'https://github.com/pimlicolabs/permissionless.js/pull/42' },
		],
	},
];

const profileJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	'@id': `${aboutUrl}#profilepage`,
	url: aboutUrl,
	name: pageTitle,
	description: pageDescription,
	inLanguage: 'en',
	mainEntity: personJsonLd,
	about: personRef,
};

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: canonical() },
		{ '@type': 'ListItem', position: 2, name: 'About', item: aboutUrl },
	],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script type="application/ld+json" set:html={JSON.stringify(profileJsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
	</head>
	<body class="bg-white dark:bg-[#0a0a0a]">
		<div class="min-h-screen bg-white dark:bg-[#0a0a0a] text-gray-800 dark:text-gray-300 font-sans selection:bg-gray-200 dark:selection:bg-white/20">
			<Navigation client:load />

			<main class="max-w-3xl mx-auto px-6 pt-32 pb-20">
				{/* Intro */}
				<section class="mb-20">
					<h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white tracking-tight mb-2">
						About {AUTHOR_NAME}
					</h1>
					<p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 font-medium mb-6">
						{JOB_TITLE}
					</p>

					<p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-4 max-w-xl">
						{TAGLINE}
					</p>

					<p class="text-gray-600 dark:text-gray-400 leading-relaxed max-w-xl">
						I write about what I actually ship: account abstraction and ERC-4337 wallets,
						WebAuthn and passkeys, smart contract development, and the infrastructure that
						keeps it all running. There are <a href="/articles/" class="text-gray-900 dark:text-white hover:text-green-600 dark:hover:text-green-400 transition-colors">{articleCount} articles</a> here,
						most of them written from production systems rather than tutorials.
					</p>

					<div class="flex flex-wrap gap-6 text-sm font-mono mt-8">
						<a href={`https://github.com/${GITHUB_HANDLE}`} target="_blank" rel="noopener noreferrer me" class="text-gray-700 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400 transition-colors">
							GitHub
						</a>
						<a href={X_PROFILE_URL} target="_blank" rel="noopener noreferrer me" class="text-gray-700 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400 transition-colors">
							X
						</a>
						<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer me" class="text-gray-700 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400 transition-colors">
							LinkedIn
						</a>
					</div>
				</section>

				{/* Career */}
				<section class="mb-20">
					<h2 class="font-mono text-xs uppercase tracking-widest text-gray-500 mb-8 border-b border-gray-300 dark:border-white/10 pb-2">
						Career
					</h2>

					<div class="space-y-8">
						{career.map((item) => (
							<div class="flex flex-col md:flex-row md:gap-8">
								<span class="font-mono text-xs text-gray-500 shrink-0 w-28 pt-1">{item.period}</span>
								<div class="flex-1">
									<h3 class="text-gray-900 dark:text-white font-medium">
										{item.role}
										<span class="text-gray-400 dark:text-gray-600 mx-2">·</span>
										{item.url ? (
											<a href={item.url} target="_blank" rel="noopener noreferrer" class="hover:text-green-600 dark:hover:text-green-400 transition-colors">
												{item.org}
											</a>
										) : (
											<span class="text-gray-600 dark:text-gray-400">{item.org}</span>
										)}
									</h3>
									<p class="text-sm text-gray-500 mt-1 leading-relaxed max-w-xl">{item.detail}</p>
								</div>
							</div>
						))}
					</div>
				</section>

				{/* Projects */}
				<section class="mb-20">
					<div class="flex items-center justify-between mb-8 border-b border-gray-300 dark:border-white/10 pb-2">
						<h2 class="font-mono text-xs uppercase tracking-widest text-gray-500">
							Projects
						</h2>
						<a href="/projects/" class="font-mono text-xs text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors">
							All projects →
						</a>
					</div>

					<div class="space-y-6">
						{projects.map((project) => (
							<div class="flex items-start gap-4">
								<div class={`p-2 rounded-lg bg-gray-100 dark:bg-white/5 shrink-0 ${project.data.iconColor || 'text-gray-500'}`}>
									<Icon name={project.data.icon} className="w-5 h-5" />
								</div>
								<div class="flex-1 min-w-0">
									<h3 class="text-gray-900 dark:text-white font-medium">
										<a href={`/projects/${project.id}/`} class="hover:text-green-600 dark:hover:text-green-400 transition-colors">
											{project.data.name}
										</a>
										<span class="text-gray-400 dark:text-gray-600 mx-2">·</span>
										<span class="text-xs font-mono text-gray-500">{project.data.role}</span>
									</h3>
									<p class="text-sm text-gray-500 mt-1 leading-relaxed max-w-xl">{project.data.tagline}</p>
								</div>
							</div>
						))}
					</div>
				</section>

				{/* Open source */}
				<section class="mb-20">
					<h2 class="font-mono text-xs uppercase tracking-widest text-gray-500 mb-6 border-b border-gray-300 dark:border-white/10 pb-2">
						Open Source
					</h2>

					<p class="text-sm text-gray-500 mb-6">
						I don't just use the tools: I write the code for the tools you use.
					</p>

					<div class="grid gap-4">
						{contributions.map((contribution) => (
							<div class="flex flex-col gap-2">
								<div class="flex items-center gap-2">
									<a href={contribution.url} target="_blank" rel="noopener noreferrer" class="text-gray-900 dark:text-white font-medium hover:text-green-600 dark:hover:text-green-400 transition-colors">
										{contribution.project}
									</a>
									<span class="text-xs text-gray-500">{contribution.context}</span>
								</div>
								<div class="flex flex-wrap gap-2 text-sm">
									{contribution.items.map((item, i) => (
										<>
											{i > 0 && <span class="text-gray-400" aria-hidden="true">·</span>}
											<a href={item.url} target="_blank" rel="noopener noreferrer" class="text-gray-600 dark:text-gray-400 hover:text-green-600 dark:hover:text-green-400 transition-colors">
												{item.label}
											</a>
										</>
									))}
								</div>
							</div>
						))}
					</div>
				</section>

				{/* Contact */}
				<section class="py-12 border-t border-gray-200 dark:border-white/10">
					<h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
						Get in Touch
					</h2>
					<p class="text-gray-600 dark:text-gray-400 mb-6 max-w-md">
						Available {AVAILABILITY}. Want to chat about Web3 infrastructure, Account
						Abstraction, or something you read here? Reach out.
					</p>

					<div class="flex flex-col sm:flex-row gap-4">
						<a
							href={CALENDLY_URL}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-medium rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors"
						>
							<Icon name="calendar" className="w-[18px] h-[18px]" />
							Book a call
						</a>
						<a
							href={TELEGRAM_URL}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center justify-center gap-2 px-6 py-3 border border-gray-300 dark:border-white/20 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-white/5 transition-colors"
						>
							<Icon name="message-circle" className="w-[18px] h-[18px]" />
							{TELEGRAM_HANDLE}
						</a>
					</div>
				</section>
			</main>

			<div class="max-w-3xl mx-auto px-6">
				<Footer />
			</div>
		</div>
	</body>
</html>
