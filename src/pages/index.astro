---
import BaseHead from '../components/BaseHead.astro';
import LandingPage from '../components/LandingPage';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { personJsonLd, organizationJsonLd, personRef, canonical } from '../lib/schema';
import { getReadingTime } from '../lib/readingTime';

const articles = await getCollection('articles');

// Project summaries come from the collection, the landing page never retypes them.
const projects = (await getCollection('projects'))
	.filter((project) => !project.data.draft)
	.sort((a, b) => a.data.order - b.data.order)
	.map((project) => ({
		slug: project.id,
		name: project.data.name,
		tagline: project.data.tagline,
		role: project.data.role,
		status: project.data.status,
		period: project.data.period,
		tech: project.data.tech.slice(0, 4),
		metrics: project.data.metrics,
	}));

const processedArticles = articles.map(article => ({
  id: article.id,
  title: article.data.title,
  subtitle: article.data.subtitle,
  category: article.data.category,
  tags: article.data.tags,
  readTime: getReadingTime(article.body || ""),
  icon: article.data.icon,
  iconColor: article.data.iconColor,
  description: article.data.description,
  date: article.data.date,
  slug: article.id,
  githubUrl: article.data.githubUrl,
  group: article.data.group,
  draft: article.data.draft,
})).filter(article => !article.draft);

// Newest first. `date` already lives on processedArticles, so no need to look
// the source article back up per comparison.
processedArticles.sort((a, b) => b.date.getTime() - a.date.getTime());

// JSON-LD for Person (shared node, see src/lib/schema.ts)
const personPageJsonLd = {
	"@context": "https://schema.org",
	...personJsonLd,
};

// JSON-LD for WebSite
const websiteJsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": SITE_TITLE,
	"url": canonical(),
	"description": SITE_DESCRIPTION,
	"inLanguage": "en",
	"author": personRef
};

// JSON-LD for Organization (Frak Labs)
const organizationPageJsonLd = {
	"@context": "https://schema.org",
	...organizationJsonLd,
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title="Quentin Nivelais, systems engineer" description={SITE_DESCRIPTION} />
		
		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(personPageJsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(organizationPageJsonLd)} />
	</head>
	<body class="bg-paper" data-pagefind-ignore>
		<LandingPage client:load articles={processedArticles} projects={projects} />
	</body>
</html>
