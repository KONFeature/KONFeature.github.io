---
import BaseHead from '../../components/BaseHead.astro';
import Navigation from '../../components/Navigation';
import Footer from '../../components/Footer';
import Icon from '../../components/Icon';
import { getCollection, render } from 'astro:content';
import { SITE_TITLE, CALENDLY_URL, CONTACT_LABEL } from '../../consts';
import { personJsonLd, personRef, canonical } from '../../lib/schema';
import { getReadingTime } from '../../lib/readingTime';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
	const projects = (await getCollection('projects')).filter((project) => !project.data.draft);
	const articles = (await getCollection('articles')).filter((article) => !article.data.draft);

	return projects.map((project) => {
		const relatedArticles = articles
			.filter((article) =>
				(article.data.group && project.data.articleGroups.includes(article.data.group)) ||
				project.data.articleIds.includes(article.id)
			)
			.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

		return {
			params: { slug: project.id },
			props: { project, relatedArticles },
		};
	});
}) satisfies GetStaticPaths;

const { project, relatedArticles } = Astro.props;
const { Content } = await render(project);

const pageTitle = `${project.data.name} | ${SITE_TITLE}`;
const pageDescription = project.data.description;
const projectUrl = canonical(`projects/${project.id}`);

const statusLabel: Record<string, string> = {
	production: 'In Production',
	internal: 'Internal Tool',
	personal: 'Personal Project',
	archived: 'Archived',
};

/**
 * Only a value carrying a number is a measured fact, so only those get the
 * accent and the large setting. The qualitative entries stay a quiet data row.
 */
const isMeasured = (value: string) => /\d/.test(value);
const measuredMetrics = project.data.metrics.filter((metric) => isMeasured(metric.value));
const qualitativeMetrics = project.data.metrics.filter((metric) => !isMeasured(metric.value));

const projectJsonLd = {
	"@context": "https://schema.org",
	"@type": "CreativeWork",
	"name": project.data.name,
	"description": project.data.description,
	"url": projectUrl,
	"creator": personJsonLd,
	"author": personRef,
	"keywords": project.data.tech.join(', '),
};

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": canonical() },
		{ "@type": "ListItem", "position": 2, "name": "Projects", "item": canonical('projects') },
		{ "@type": "ListItem", "position": 3, "name": project.data.name, "item": projectUrl },
	],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script type="application/ld+json" set:html={JSON.stringify(projectJsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
	</head>
	<body class="bg-paper">
		<div class="min-h-screen bg-paper font-sans text-ink-2">
			<Navigation client:load />

			<main id="main" class="mx-auto max-w-page px-6 pt-28 pb-24">
				<a href="/projects/" class="link-quiet text-sm">All projects</a>

				{/* Record header: icon and identity left, tagline right. Stacks below md. */}
				<header class="mt-8 grid gap-x-10 gap-y-5 border-b border-rule pb-8 md:grid-cols-12">
					<div class="md:col-span-5">
						<div class="flex items-start gap-3">
							<Icon
								name={project.data.icon}
								className="h-7 w-7 shrink-0 text-ink-3 [stroke-width:1.5]"
							/>
							<div class="min-w-0">
								<h1 class="text-3xl font-semibold text-ink md:text-4xl">{project.data.name}</h1>
								<p class="mt-3 font-mono text-xs text-ink-3">{project.data.role}</p>
								<p class="font-mono text-xs text-ink-3">{project.data.period}</p>
								<p class="mt-2 font-mono text-xs text-ink-3">
									{statusLabel[project.data.status]}
								</p>
							</div>
						</div>
					</div>

					<div class="md:col-span-7">
						<p class="max-w-measure text-md text-ink">{project.data.tagline}</p>

						<ul class="mt-5 flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs text-ink-3">
							{project.data.tech.map((tech) => (
								<li>{tech}</li>
							))}
						</ul>

						{project.data.links.length > 0 && (
							<ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
								{project.data.links.map((link) => (
									<li>
										<a href={link.url} target="_blank" rel="noopener noreferrer" class="link">
											{link.label}
										</a>
									</li>
								))}
							</ul>
						)}
					</div>
				</header>

				{/* Measured facts. Hairline separation, no panel. Wraps to one per line on narrow screens. */}
				{measuredMetrics.length > 0 && (
					<dl class="flex flex-wrap gap-x-12 gap-y-6 border-b border-rule py-8">
						{/* Each pair is reversed so the value reads first while dt stays before dd. */}
						{measuredMetrics.map((metric) => (
							<div class="flex flex-col-reverse">
								<dt class="mt-1 text-xs text-ink-3">{metric.label}</dt>
								<dd class="metric-value text-2xl">{metric.value}</dd>
							</div>
						))}
					</dl>
				)}

				{qualitativeMetrics.length > 0 && (
					<dl class="grid gap-x-10 gap-y-2 border-b border-rule py-5 font-mono text-xs md:grid-cols-2">
						{qualitativeMetrics.map((metric) => (
							<div class="flex gap-4">
								<dt class="w-40 shrink-0 text-ink-3">{metric.label}</dt>
								<dd class="text-ink-2">{metric.value}</dd>
							</div>
						))}
					</dl>
				)}

				<div class="prose max-w-measure pt-4 pb-14">
					<Content />
				</div>

				{relatedArticles.length > 0 && (
					<section class="border-t border-rule pt-10">
						<h2 class="text-xl font-semibold text-ink">Articles about this project</h2>

						<div class="mt-6 border-t border-rule">
							{relatedArticles.map((article) => (
								<a
									href={`/articles/${article.id}/`}
									class="group -mx-4 grid gap-x-10 gap-y-2 border-b border-rule px-4 py-6 md:grid-cols-12"
								>
									{/* Date column at md and up, inline above the title below it. */}
									<time
										datetime={article.data.date.toISOString()}
										class="font-mono text-xs text-ink-3 md:col-span-2"
									>
										{article.data.date.toLocaleDateString('en-US', {
											month: 'short',
											day: 'numeric',
											year: 'numeric',
										})}
									</time>

									<div class="md:col-span-10">
										<h3 class="text-lg font-semibold text-ink underline decoration-transparent underline-offset-4 transition-colors duration-150 group-hover:decoration-rule-strong">
											{article.data.title}
										</h3>
										<p class="mt-2 max-w-measure text-sm text-ink-2">
											{article.data.description}
										</p>
										<p class="mt-3 font-mono text-xs text-ink-3">
											{getReadingTime(article.body || '')}
										</p>
									</div>
								</a>
							))}
						</div>
					</section>
				)}

				<section class="mt-16 border-t border-rule pt-12">
					<h2 class="text-xl font-semibold text-ink">Working on something similar?</h2>
					<p class="mt-3 max-w-measure text-ink-2">
						Happy to go through the technical details, or look at the same problem in your
						system.
					</p>
					<a
						href={CALENDLY_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-primary mt-6"
					>
						<Icon name="calendar" className="h-4 w-4 [stroke-width:1.5]" />
						{CONTACT_LABEL}
					</a>
				</section>

				<Footer client:load />
			</main>
		</div>
	</body>
</html>
