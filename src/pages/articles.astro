---
import BaseHead from '../components/BaseHead.astro';
import Navigation from '../components/Navigation';
import Footer from '../components/Footer';
import ArticlesPage from '../components/ArticlesPage';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import { personJsonLd, canonical } from '../lib/schema';
import { getReadingTime } from '../lib/readingTime';

const articles = (await getCollection('articles')).filter(article => !article.data.draft);

// Count is derived so the description can never drift from the corpus.
const ARCHIVE_DESCRIPTION = `All ${articles.length} engineering deep-dives: account abstraction, WebAuthn wallets, Solidity, Kubernetes, self-hosted infrastructure and embedded firmware.`;

const processedArticles = articles.map(article => ({
  id: article.id,
  title: article.data.title,
  subtitle: article.data.subtitle,
  category: article.data.category,
  tags: article.data.tags,
  readTime: getReadingTime(article.body || ""),
  icon: article.data.icon,
  iconColor: article.data.iconColor,
  featured: article.data.featured,
  description: article.data.description,
  date: article.data.date,
  slug: article.id,
  githubUrl: article.data.githubUrl,
  group: article.data.group,
}));

// Newest first. `date` already lives on processedArticles.
processedArticles.sort((a, b) => b.date.getTime() - a.date.getTime());

const articlesJsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": `All Articles | ${SITE_TITLE}`,
	"description": ARCHIVE_DESCRIPTION,
	"url": canonical('articles'),
	"mainEntity": {
		"@type": "ItemList",
		// Every article is rendered on this page, so list them all rather than
		// declaring a count that does not match itemListElement.
		"numberOfItems": processedArticles.length,
		"itemListElement": processedArticles.map((article, i) => ({
			"@type": "ListItem",
			"position": i + 1,
			"url": canonical(`articles/${article.slug}`),
			"name": article.title,
		})),
	},
	"author": personJsonLd,
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={`All Articles | ${SITE_TITLE}`} description={ARCHIVE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(articlesJsonLd)} />
	</head>
	<body class="bg-paper" data-pagefind-ignore>
		<div class="min-h-screen bg-paper font-sans">
			<Navigation client:load />

			<main id="main" class="max-w-page mx-auto px-6 pt-28 pb-20">
				<ArticlesPage client:load articles={processedArticles} />
			</main>

			<Footer />
		</div>
	</body>
</html>
