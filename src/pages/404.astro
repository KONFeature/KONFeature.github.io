---
import Navigation from '../components/Navigation';
import Footer from '../components/Footer';
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';

const pageTitle = 'Page not found';
const pageDescription = `This page doesn't exist. Browse the articles and projects on ${SITE_TITLE} instead.`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} noIndex={true} />
	</head>
	<body class="bg-paper font-sans text-ink-2">
		<Navigation client:load />

		<main id="main" class="mx-auto max-w-page px-6 pt-32 pb-20">
			<div class="max-w-measure">
				<p class="font-mono text-sm text-ink">404</p>
				<h1 class="mt-3 text-2xl font-semibold text-ink md:text-3xl">Page not found</h1>
				<p class="mt-4 text-md text-ink-2">
					Nothing is served at this address. The page was either moved or never existed.
				</p>

				<ul class="mt-8 space-y-3 text-md">
					<li>
						<a href="/articles/" class="link">Article archive</a>
					</li>
					<li>
						<a href="/" class="link">Home page</a>
					</li>
				</ul>
			</div>
		</main>

		<Footer />
	</body>
</html>
